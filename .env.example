# ADIFY environment configuration. Copy to .env.local and fill in real values.
# Never commit real secrets. Only variables actually used by the implementation are listed.

# Primary database (Neon PostgreSQL) — the source of truth.
DATABASE_URL=

# Explicit local-development database opt-in. When DATABASE_URL is unset and
# this is not 'true', the app fails with a clear database_unavailable error
# instead of silently using anything else.
ALLOW_LOCAL_DB=

# Override the local store location (used by the test suite).
DATA_FILE=

# App base URL used for email links and metadata.
APP_BASE_URL=http://localhost:3000

# Transactional email (Nodemailer + Google SMTP). Without these, emails stay
# queued in the durable outbox and in-app notifications still work.
# Legacy aliases SMTP_PASS/SMTP_FROM are still honored if present.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SUPPORT_EMAIL=

# Optional default recipient for `npm run email:test --` (the --to flag wins).
EMAIL_TEST_TO=
